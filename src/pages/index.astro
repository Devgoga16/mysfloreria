---
import Base from "../layouts/Base.astro";
import { Image } from "astro:assets";
import Icon from "../components/Icon.astro";
import PortadaCarousel from "../components/PortadaCarousel.astro";
import Categorias from "../components/Categorias.astro";
import { site, waLink, unsplash as u } from "../data/site";
import fotoPersonalizado from "../assets/galeria/11.jpg";

const pasos = [
  { titulo: "Elige tu arreglo", texto: "Escoge el diseño, el tamaño y agrega un detalle si quieres." },
  { titulo: "Paga en línea", texto: "Indica la fecha y la dirección, y paga en una ventana segura." },
  { titulo: "Lo llevamos por ti", texto: "Lo preparamos a mano y lo entregamos, o lo recoges en tienda." },
] as const;

const entregas = [
  { icon: "truck", titulo: "Delivery en Lima", texto: "A domicilio, en la fecha que elijas." },
  { icon: "store", titulo: "Recojo en tienda", texto: "Av. Metropolitana 407, Comas." },
  { icon: "wallet", titulo: "Yape, Plin o transferencia", texto: "Pago seguro al finalizar tu pedido." },
  { icon: "clock", titulo: "Atención todos los días", texto: "De 7:30 a.m. a 11:30 p.m." },
] as const;

const valores = [
  { icon: "hand", titulo: "Hecho a mano", texto: "Cada arreglo se arma uno por uno." },
  { icon: "palette", titulo: "A tu medida", texto: "Elegimos contigo colores y estilo." },
  { icon: "gift", titulo: "Cuidamos el detalle", texto: "Envolturas y acabados cuidados." },
  { icon: "chat", titulo: "Atención cercana", texto: "Te acompañamos por WhatsApp." },
] as const;

// Galería: pega tus fotos en src/assets/galeria/ (jpg, png o webp).
// Se muestran las 6 primeras ordenadas por nombre (1.jpg, 2.jpg, … 10.jpg).
// Las fotos .jfif son JPG: basta cambiarles la extensión a .jpg.
// Mientras la carpeta esté vacía se usan las fotos de ejemplo de abajo.
const fotosPropias = Object.entries(
  import.meta.glob<{ default: ImageMetadata }>("../assets/galeria/*.{jpg,jpeg,png,webp,JPG,JPEG,PNG,WEBP}", { eager: true }),
)
  .sort(([a], [b]) => a.localeCompare(b, undefined, { numeric: true }))
  .map(([, m]) => m.default)
  .slice(0, 6);

const galeriaEjemplo = [
  "photo-1526047932273-341f2a7631f9",
  "photo-1563241527-3004b7be0ffd",
  "photo-1457089328109-e5d9bd499191",
  "photo-1582794543139-8ac9cb0f7b11",
  "photo-1468327768560-75b778cbb551",
  "photo-1519378058457-4c29a0a2efac",
];
---
<Base>
  <!-- ================= PORTADAS (editar en src/data/banners.ts) ================= -->
  <PortadaCarousel />

  <!-- ================= POR QUÉ M&S (franja bajo la portada) ================= -->
  <section class="container perks" id="nosotros" aria-labelledby="why-title">
    <h2 class="sr-only" id="why-title">Por qué elegir M&amp;S Detalles</h2>
    <ul class="perks__list">
      {valores.map((v, i) => (
        <li class={`reveal${i ? ` reveal--d${Math.min(i, 3)}` : ""}`}><span class="perks__icon"><Icon name={v.icon} /></span><strong>{v.titulo}</strong><span>{v.texto}</span></li>
      ))}
    </ul>
  </section>


  <!-- ================= CATEGORÍAS (editar en src/data/categorias.ts) ================= -->
  <Categorias />

  <!-- ================= LOS MÁS PEDIDOS (desde uTracker) ================= -->
  <section class="container section section--flush-top featured-sec" id="catalogo">
    <div class="split-head reveal">
      <div>
        <h2 class="title">Los más pedidos</h2>
        <p class="muted">Diseños listos para regalar, preparados a mano.</p>
      </div>
      <div class="featured__actions">
        <a href="/tienda" class="link">Ver toda la tienda <Icon name="arrow" /></a>
        <button class="round-btn" data-dir="-1" aria-label="Anterior"><Icon name="arrow-left" /></button>
        <button class="round-btn round-btn--fill" data-dir="1" aria-label="Siguiente"><Icon name="arrow" /></button>
      </div>
    </div>
    <div class="tabs" role="tablist" aria-label="Filtrar por categoría" id="featured-tabs" hidden></div>
    <div class="catalog__track" id="destacados"></div>
  </section>

  <!-- ================= COMPLEMENTOS (desde uTracker) ================= -->
  <section class="container extras" id="complementos" hidden>
    <div class="split-head reveal">
      <div>
        <h2 class="title">Súmale un detalle</h2>
        <p class="muted">Se entrega junto con tu arreglo.</p>
      </div>
      <a href="/tienda?cat=Complementos" class="link">Ver complementos <Icon name="arrow" /></a>
    </div>
    <ul class="minis minis--row" id="extras-list"></ul>
  </section>

  <!-- ================= COMPRAR ES FÁCIL (pasos + entregas) ================= -->
  <section class="easy" id="como-comprar">
    <div class="container easy__grid">
      <div class="easy__steps reveal">
        <span class="eyebrow">Cómo comprar</span>
        <h2 class="title">Regalar flores, <em>sin complicaciones</em></h2>
        <ol>
          {pasos.map((p, i) => (
            <li>
              <span class="easy__num">{i + 1}</span>
              <div><strong>{p.titulo}</strong><span>{p.texto}</span></div>
            </li>
          ))}
        </ol>
        <a href="/tienda" class="btn btn--primary btn--lg">Empezar a comprar <Icon name="arrow" /></a>
      </div>
      <ul class="easy__info reveal reveal--d1" id="entregas" aria-label="Entregas y pagos">
        {entregas.map((e) => (
          <li><span class="easy__icon"><Icon name={e.icon} /></span><strong>{e.titulo}</strong><span>{e.texto}</span></li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ================= PEDIDO PERSONALIZADO ================= -->
  <section class="section container" id="personalizado">
    <div class="custom reveal">
      <div class="custom__copy">
        <span class="eyebrow eyebrow--line">Pedido personalizado</span>
        <h2 class="title">¿Tienes una idea <em>en mente?</em></h2>
        <p>Cuéntanos la ocasión, los colores que le gustan y tu presupuesto. Diseñamos el arreglo contigo, paso a paso.</p>
        <a href={waLink("¡Hola! Quisiera diseñar un arreglo personalizado 🌷")} target="_blank" rel="noopener" class="btn btn--white btn--lg"><Icon name="chat" /> Escríbenos por WhatsApp</a>
      </div>
      <div class="custom__media">
        <Image src={fotoPersonalizado} alt="Ramo personalizado de M&S Detalles" width={800} loading="lazy" decoding="async" />
      </div>
    </div>
  </section>

  <!-- ================= NUESTROS TRABAJOS (galería) ================= -->
  <section class="section section--flush-top container">
    <div class="split-head reveal">
      <div>
        <h2 class="title">Nuestros trabajos</h2>
        <p class="muted">Arreglos reales que preparamos para nuestros clientes.</p>
      </div>
      <a href={site.redes.instagram} target="_blank" rel="noopener" class="link"><Icon name="instagram" /> Síguenos en Instagram</a>
    </div>
    <div class="gallery reveal reveal--d1" style={`--cols: ${fotosPropias.length || galeriaEjemplo.length}`}>
      {fotosPropias.length
        ? fotosPropias.map((foto) => (
            <a href={site.redes.instagram} target="_blank" rel="noopener" aria-label="Ver en Instagram">
              <Image src={foto} alt="" width={600} loading="lazy" decoding="async" />
            </a>
          ))
        : galeriaEjemplo.map((g) => (
            <a href={site.redes.instagram} target="_blank" rel="noopener" aria-label="Ver en Instagram">
              <img src={u(g, 400)} alt="" width="400" height="400" loading="lazy" decoding="async" />
            </a>
          ))}
    </div>
  </section>
</Base>

<script>
  import { loadCatalog, renderProducts, renderSkeleton, renderError, availableComplements, miniCard, esc } from "../lib/shop";
  import { isComplement, type Product } from "../lib/utracker";

  const track = document.getElementById("destacados")!;
  const tabs = document.getElementById("featured-tabs")!;
  let pool: Product[] = [];
  let active = "";

  function show() {
    renderProducts(track, pool.filter((p) => !active || p.category === active).slice(0, 10));
    track.scrollTo({ left: 0 });
  }

  async function load() {
    renderSkeleton(track);
    try {
      const { products, categories } = await loadCatalog();
      // Primero los disponibles
      pool = products.filter((p) => !isComplement(p)).sort((a, b) => Number(b.inStock) - Number(a.inStock));
      // Pestañas: solo categorías con al menos 2 arreglos, para que valga la pena filtrar
      const count = (c: string) => pool.filter((p) => p.category === c).length;
      const cats = categories.filter((c) => count(c) >= 2);
      tabs.innerHTML = ["", ...cats]
        .map((c) => `<button role="tab" class="tab${c === active ? " is-active" : ""}" aria-selected="${c === active}" data-tab="${esc(c)}">${c ? esc(c) : "Todos"}</button>`)
        .join("");
      tabs.hidden = cats.length === 0;
      show();
      const extras = availableComplements(10);
      if (extras.length) {
        document.getElementById("extras-list")!.innerHTML = extras.map(miniCard).join("");
        document.getElementById("complementos")!.hidden = false;
      }
    } catch (err) {
      renderError(track, err, load);
    }
  }
  tabs.addEventListener("click", (e) => {
    const b = (e.target as HTMLElement).closest<HTMLButtonElement>("[data-tab]");
    if (!b) return;
    active = b.dataset.tab || "";
    tabs.querySelectorAll(".tab").forEach((t) => {
      t.classList.toggle("is-active", t === b);
      t.setAttribute("aria-selected", String(t === b));
    });
    show();
  });
  load();
  document.addEventListener("catalog:refresh", load);

  document.querySelectorAll<HTMLButtonElement>(".featured__actions .round-btn").forEach((btn) =>
    btn.addEventListener("click", () => {
      const card = track.querySelector<HTMLElement>(".product");
      if (card) track.scrollBy({ left: Number(btn.dataset.dir) * (card.offsetWidth + 24), behavior: "smooth" });
    }),
  );
</script>
