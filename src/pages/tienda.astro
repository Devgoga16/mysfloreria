---
import Base from "../layouts/Base.astro";
import { waLink } from "../data/site";
---
<Base
  title="Tienda | M&S Detalles · Ramos y arreglos con delivery en Lima"
  description="Compra ramos de rosas, tulipanes, girasoles y arreglos florales en línea. Delivery en Lima o recojo en tienda."
>
  <section class="shop-hero">
    <div class="container">
      <span class="eyebrow eyebrow--line">Tienda en línea</span>
      <h1 class="display">Encuentra el arreglo <em>perfecto</em></h1>
      <p class="lead">Elige, agrega al carrito y paga en minutos. Preparamos cada pedido a mano, con todo el cariño.</p>
    </div>
  </section>

  <section class="container shop">
    <div class="notice" id="offline-notice" hidden>
      Por el momento no estamos recibiendo pedidos en línea. Puedes ver el catálogo y
      <a href={waLink()} target="_blank" rel="noopener">pedir por WhatsApp</a>.
    </div>

    <div class="campaigns" id="campaigns" hidden></div>

    <div class="shop__toolbar">
      <label class="search">
        <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-4-4"/></svg>
        <input type="search" id="q" placeholder="Buscar rosas, girasoles, tulipanes…" aria-label="Buscar" />
      </label>
      <div class="shop__selects" id="filters"></div>
      <select id="sort" aria-label="Ordenar">
        <option value="">Recomendados</option>
        <option value="asc">Menor precio</option>
        <option value="desc">Mayor precio</option>
      </select>
    </div>
    <div class="chips" id="categories" role="tablist" aria-label="Categorías"></div>
    <p class="shop__count" id="count"></p>
    <div class="shop__grid" id="grid"></div>
    <div class="shop__more" id="more" hidden>
      <p id="more-text"></p>
      <div class="shop__progress"><span id="more-bar"></span></div>
      <button class="btn btn--ghost btn--lg" id="more-btn">Ver más arreglos</button>
    </div>
  </section>
</Base>

<script>
  import { getConfig, getCampaigns, minPrice, soles, isComplement, type Product } from "../lib/utracker";
  import { loadCatalog, renderProducts, renderSkeleton, renderError, productCard, esc, norm } from "../lib/shop";

  const grid = document.getElementById("grid")!;
  const q = document.getElementById("q") as HTMLInputElement;
  const sort = document.getElementById("sort") as HTMLSelectElement;
  const cats = document.getElementById("categories")!;
  const filtersEl = document.getElementById("filters")!;
  const count = document.getElementById("count")!;

  let products: Product[] = [];
  // "Ver más": se muestran de 12 en 12
  const PAGE = 12;
  let current: Product[] = [];
  let shown = PAGE;
  const more = document.getElementById("more")!;
  function renderMore() {
    more.hidden = current.length <= shown;
    const visible = Math.min(shown, current.length);
    document.getElementById("more-text")!.textContent = `Viendo ${visible} de ${current.length}`;
    (document.getElementById("more-bar") as HTMLElement).style.width = `${(visible / Math.max(current.length, 1)) * 100}%`;
  }
  const params = new URLSearchParams(location.search);
  // ?cat=Rosas (barra de categorías), ?q=rosas (buscador de la cabecera)
  let category = params.get("cat") ?? "";
  if (params.get("q")) q.value = params.get("q")!;
  const selected: Record<string, string> = {};
  // Viene de "Compra por ocasión": ?ocasion=Cumpleaños
  let pendingOcasion = params.get("ocasion") ?? "";

  function apply() {
    const words = norm(q.value.trim()).split(/\s+/).filter(Boolean);
    let list = products.filter((p) => {
      if (category && p.category !== category) return false;
      // Los complementos solo aparecen en su categoría o al buscarlos
      if (!category && !words.length && isComplement(p)) return false;
      const hay = norm(`${p.name} ${p.description} ${p.category}`);
      if (words.length && !words.every((w) => hay.includes(w))) return false;
      return Object.entries(selected).every(
        ([fid, val]) => !val || p.attributes.some((a) => a.filter === fid && a.values.includes(val)),
      );
    });
    if (sort.value) list = [...list].sort((a, b) => (minPrice(a) - minPrice(b)) * (sort.value === "asc" ? 1 : -1));
    else list = [...list].sort((a, b) => Number(b.inStock) - Number(a.inStock));
    count.textContent = `${list.length} ${list.length === 1 ? "resultado" : "resultados"}${q.value.trim() ? ` para “${q.value.trim()}”` : ""}`;
    current = list;
    shown = PAGE;
    renderProducts(grid, list.slice(0, shown));
    renderMore();
  }

  function renderCategories(categories: string[]) {
    cats.innerHTML = ["", ...categories]
      .map((c) => `<button role="tab" class="chip-btn${c === category ? " is-active" : ""}" data-cat="${esc(c)}">${c ? esc(c) : "Todos"}</button>`)
      .join("");
  }

  async function load() {
    renderSkeleton(grid, 8);
    try {
      const [config, data] = await Promise.all([getConfig(), loadCatalog()]);
      products = data.products;
      document.getElementById("offline-notice")!.hidden = config.store.acceptsOnlineOrders;

      const used = new Set(products.map((p) => p.category));
      const cats = data.categories.filter((c) => used.has(c));
      // complementos al final de las categorías
      const isExtra = (c: string) => products.some((p) => p.category === c && isComplement(p));
      renderCategories([...cats.filter((c) => !isExtra(c)), ...cats.filter(isExtra)]);
      // Si la ocasión coincide con un valor de algún filtro, se usa ese filtro; si no, se busca por texto.
      if (pendingOcasion) {
        const target = norm(pendingOcasion);
        const match = config.filters
          .flatMap((f) => f.values.map((v) => ({ f, v })))
          .find(({ v }) => norm(v) === target);
        if (match) selected[match.f.id] = match.v;
        else q.value = pendingOcasion;
        pendingOcasion = "";
      }
      filtersEl.innerHTML = config.filters
        .map((f) => `<select data-filter="${esc(f.id)}" aria-label="${esc(f.name)}"><option value="">${esc(f.name)}: todos</option>${f.values.map((v) => `<option value="${esc(v)}"${selected[f.id] === v ? " selected" : ""}>${esc(v)}</option>`).join("")}</select>`)
        .join("");
      apply();
    } catch (err) {
      renderError(grid, err, load);
    }
  }

  async function loadCampaigns() {
    try {
      const active = (await getCampaigns()).filter((c) => c.status === "active");
      if (!active.length) return;
      const el = document.getElementById("campaigns")!;
      el.hidden = false;
      el.innerHTML = active
        .map(
          (c) => `<a class="campaign" href="${esc(c.url)}" target="_blank" rel="noopener">
            ${c.items[0]?.imageUrl ? `<img src="${esc(c.items[0].imageUrl)}" alt="" />` : ""}
            <div><span class="eyebrow">Por tiempo limitado · hasta el ${new Date(c.endDate).toLocaleDateString("es-PE", { day: "numeric", month: "long" })}</span>
            <strong class="serif">${esc(c.name)}</strong>
            <small>${c.items.length} ${c.items.length === 1 ? "producto" : "productos"} desde ${soles(Math.min(...c.items.map((i) => i.price)))}</small></div>
            <span class="btn__icon"><svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg></span></a>`,
        )
        .join("");
    } catch {
      /* las campañas son opcionales */
    }
  }

  cats.addEventListener("click", (e) => {
    const b = (e.target as HTMLElement).closest<HTMLButtonElement>("[data-cat]");
    if (!b) return;
    category = b.dataset.cat || "";
    cats.querySelectorAll(".chip-btn").forEach((x) => x.classList.toggle("is-active", x === b));
    const u = new URL(location.href);
    if (category) u.searchParams.set("cat", category); else u.searchParams.delete("cat");
    history.replaceState(null, "", u);
    apply();
  });
  filtersEl.addEventListener("change", (e) => {
    const s = e.target as HTMLSelectElement;
    selected[s.dataset.filter!] = s.value;
    apply();
  });
  grid.addEventListener("click", (e) => {
    if (!(e.target as HTMLElement).closest("[data-reset]")) return;
    category = "";
    q.value = "";
    sort.value = "";
    Object.keys(selected).forEach((k) => (selected[k] = ""));
    filtersEl.querySelectorAll("select").forEach((s) => (s.value = ""));
    cats.querySelectorAll(".chip-btn").forEach((x, i) => x.classList.toggle("is-active", i === 0));
    history.replaceState(null, "", location.pathname);
    apply();
  });
  document.getElementById("more-btn")!.addEventListener("click", () => {
    const from = shown;
    shown += PAGE;
    grid.insertAdjacentHTML("beforeend", current.slice(from, shown).map(productCard).join(""));
    // lleva el foco al primer producto nuevo (teclado y lectores de pantalla)
    grid.querySelectorAll<HTMLElement>(".product")[from]?.querySelector<HTMLElement>(".product__info")?.focus({ preventScroll: true });
    renderMore();
  });
  q.addEventListener("input", apply);
  sort.addEventListener("change", apply);
  document.addEventListener("catalog:refresh", load);

  load();
  loadCampaigns();
</script>
