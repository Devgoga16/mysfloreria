---
import { waLink } from "../data/site";
import Icon from "./Icon.astro";
---
<div class="topbar">
  <div class="container">
    <Icon name="truck" />
    <span>Delivery a domicilio en Lima · <a href={waLink("¡Hola! ¿Hacen delivery a mi distrito? 🚚")} target="_blank" rel="noopener">Consulta tu distrito</a></span>
  </div>
</div>
<header class="header">
  <div class="nav container">
    <button class="nav__toggle" aria-label="Abrir menú" aria-expanded="false" aria-controls="menu-movil">
      <span></span><span></span>
    </button>

    <form class="hsearch" role="search" data-search action="/tienda">
      <Icon name="search" />
      <input type="search" name="q" placeholder="Busca rosas, girasoles, tulipanes…" autocomplete="off"
             aria-label="Buscar arreglos" aria-expanded="false" aria-controls="search-results" enterkeyhint="search" />
      <div class="search-results" id="search-results" hidden></div>
    </form>

    <a href="/" class="logo" aria-label="Florería M&amp;S Detalles, inicio">
      <span class="logo__word" aria-hidden="true">Florería</span>
      <img src="/logo-monograma.png" alt="" class="logo__img" width="360" height="146" />
      <span class="logo__divider" aria-hidden="true">
        <i></i><svg viewBox="0 0 24 24"><path d="M12 21s-7-4.4-7-10.2A3.8 3.8 0 0 1 12 8.6a3.8 3.8 0 0 1 7 2.2C19 16.6 12 21 12 21z"/></svg><i></i>
      </span>
      <span class="logo__word" aria-hidden="true">Detalles</span>
    </a>

    <div class="nav__end">
      <button class="head-btn fav-head" data-drawer-open="favs" aria-label="Ver favoritos">
        <Icon name="heart" /><span class="head-btn__label">Favoritos</span>
        <span class="head-btn__count js-fav-count" hidden>0</span>
      </button>
      <button class="head-btn cart-btn" data-drawer-open="cart" aria-label="Abrir carrito">
        <Icon name="bag" /><span class="head-btn__label">Carrito</span>
        <span class="head-btn__count js-cart-count" hidden>0</span>
      </button>
    </div>
  </div>

  <nav class="catnav" aria-label="Categorías">
    <div class="container catnav__inner">
      <ul class="catnav__list" id="catnav">
        <li><a href="/tienda">Todo</a></li>
        <li><a href="/tienda?cat=Ramos%20de%20flores">Ramos de flores</a></li>
        <li><a href="/tienda?cat=Box%20florales">Box florales</a></li>
        <li><a href="/tienda?cat=Condolencias">Condolencias</a></li>
      </ul>
      <a href={waLink("¡Hola! Quisiera un arreglo personalizado 🌷")} target="_blank" rel="noopener" class="catnav__cta">
        <Icon name="sparkle" /> Pedido personalizado
      </a>
    </div>
  </nav>

  <div class="mobile-menu" id="menu-movil">
    <a href="/tienda">Tienda</a>
    <a href="/#categorias">Categorías</a>
    <a href="/#como-comprar">Cómo comprar</a>
    <a href="/#nosotros">Nosotros</a>
    <a href="/ayuda/preguntas-frecuentes">Preguntas frecuentes</a>
    <a href="/#contacto">Contacto</a>
    <a href={waLink()} target="_blank" rel="noopener" class="btn btn--primary btn--lg">Pedir por WhatsApp</a>
  </div>
</header>

<script>
  import { loadCatalog, esc } from "../lib/shop";
  import { isComplement } from "../lib/utracker";

  const header = document.querySelector<HTMLElement>(".header")!;
  const toggle = document.querySelector<HTMLButtonElement>(".nav__toggle")!;
  const menu = document.querySelector(".mobile-menu")!;
  const set = (open: boolean) => {
    menu.classList.toggle("is-open", open);
    toggle.setAttribute("aria-expanded", String(open));
    toggle.setAttribute("aria-label", open ? "Cerrar menú" : "Abrir menú");
  };
  toggle.addEventListener("click", () => set(!menu.classList.contains("is-open")));
  menu.querySelectorAll("a").forEach((a) => a.addEventListener("click", () => set(false)));
  document.addEventListener("keydown", (e) => e.key === "Escape" && set(false));

  // Al bajar: línea y sombra, y la cabecera se compacta (el logo queda en M&S).
  // Se usan dos umbrales distintos para que no "salte" al quedar justo en el límite.
  const onScroll = () => {
    const y = window.scrollY;
    header.classList.toggle("is-scrolled", y > 8);
    if (y > 140) header.classList.add("is-condensed");
    else if (y < 40) header.classList.remove("is-condensed");
  };
  onScroll();
  window.addEventListener("scroll", onScroll, { passive: true });

  // Barra de categorías: se arma sola con las categorías de uTracker
  loadCatalog()
    .then(({ products, categories }) => {
      const used = new Set(products.map((p) => p.category));
      const cats = categories.filter((c) => used.has(c));
      const regular = cats.filter((c) => !products.some((p) => p.category === c && isComplement(p)));
      const extras = cats.filter((c) => !regular.includes(c));
      const current = new URLSearchParams(location.search).get("cat");
      const link = (c: string) =>
        `<li><a href="/tienda?cat=${encodeURIComponent(c)}"${current === c ? ' aria-current="page"' : ""}>${esc(c)}</a></li>`;
      document.getElementById("catnav")!.innerHTML =
        `<li><a href="/tienda"${location.pathname.startsWith("/tienda") && !current ? ' aria-current="page"' : ""}>Todo</a></li>` +
        [...regular, ...extras].map(link).join("");
    })
    .catch(() => {});
</script>
