---
// Carrusel de portadas: se desliza con el dedo, con flechas y puntos,
// y avanza solo cada 6 s. Solo se detiene mientras alguien la desliza con el dedo.
import { Image } from "astro:assets";
import Icon from "./Icon.astro";
import { portadas } from "../data/banners";
---
<section class="container portada" aria-roledescription="carrusel" aria-label="Portadas">
  <div class="portada__frame">
    <div class="portada__track" data-track>
      {portadas.map((p, i) => (
        <a
          href={p.href}
          class="portada__slide"
          aria-roledescription="diapositiva"
          aria-label={`${i + 1} de ${portadas.length}`}
        >
          <Image
            src={p.image}
            alt={p.alt}
            widths={[768, 1280, 1600, p.image.width]}
            sizes="(max-width: 1280px) 100vw, 1240px"
            loading={i === 0 ? "eager" : "lazy"}
            fetchpriority={i === 0 ? "high" : "auto"}
            decoding="async"
            class="portada__img"
          />
        </a>
      ))}
    </div>
    {portadas.length > 1 && (
      <button class="portada__arrow portada__arrow--prev" data-prev aria-label="Portada anterior"><Icon name="arrow-left" /></button>
      <button class="portada__arrow portada__arrow--next" data-next aria-label="Portada siguiente"><Icon name="arrow" /></button>
    )}
  </div>
  <!-- Barra bajo la portada: acción de la portada visible, puntos y pausa -->
  <div class="portada__bar">
    <a class="portada__cta" href={portadas[0].href} data-cta>
      <span data-cta-text>{portadas[0].cta}</span><Icon name="arrow" />
    </a>
    {portadas.length > 1 && (
      <div class="portada__controls">
        <div class="portada__dots" role="tablist" aria-label="Elegir portada">
          {portadas.map((_, i) => (
            <button role="tab" class={i === 0 ? "is-active" : ""} aria-selected={i === 0 ? "true" : "false"} aria-label={`Portada ${i + 1}`} data-dot={i}><span></span></button>
          ))}
        </div>
        <button class="portada__pause" data-pause aria-label="Pausar portadas" aria-pressed="false">
          <svg class="icon icon--pause" viewBox="0 0 24 24" aria-hidden="true"><path d="M9 6v12M15 6v12"/></svg>
          <svg class="icon icon--play" viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5.5v13l10.5-6.5z"/></svg>
        </button>
      </div>
    )}
  </div>
  <script type="application/json" data-portadas set:html={JSON.stringify(portadas.map((p) => ({ href: p.href, cta: p.cta })))} />
</section>

<script>
  document.querySelectorAll<HTMLElement>(".portada").forEach((root) => {
    const track = root.querySelector<HTMLElement>("[data-track]")!;
    const slides = [...track.children] as HTMLElement[];
    const dots = [...root.querySelectorAll<HTMLButtonElement>("[data-dot]")];
    const cta = root.querySelector<HTMLAnchorElement>("[data-cta]")!;
    const ctaText = root.querySelector<HTMLElement>("[data-cta-text]")!;
    const meta: { href: string; cta: string }[] = JSON.parse(root.querySelector("[data-portadas]")!.textContent || "[]");
    if (slides.length < 2) return;
    let index = 0;
    const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;
    const go = (i: number) => {
      index = (i + slides.length) % slides.length;
      track.scrollTo({ left: slides[index].offsetLeft - track.offsetLeft, behavior: reduce ? "auto" : "smooth" });
    };

    // El punto activo sigue a la portada visible (también al deslizar con el dedo)
    const io = new IntersectionObserver(
      (entries) =>
        entries.forEach((e) => {
          if (!e.isIntersecting) return;
          index = slides.indexOf(e.target as HTMLElement);
          dots.forEach((d, k) => {
            d.classList.toggle("is-active", k === index);
            d.setAttribute("aria-selected", String(k === index));
          });
          // el botón de abajo dice qué hace la portada visible
          if (meta[index]) {
            cta.href = meta[index].href;
            ctaText.textContent = meta[index].cta;
          }
          restart();
        }),
      { root: track, threshold: 0.6 },
    );
    slides.forEach((s) => io.observe(s));

    root.querySelector("[data-prev]")!.addEventListener("click", () => go(index - 1));
    root.querySelector("[data-next]")!.addEventListener("click", () => go(index + 1));
    dots.forEach((d, k) => d.addEventListener("click", () => go(k)));

    // Avance automático
    const DELAY = 6000;
    let timer = 0;
    let paused = reduce;
    function restart() {
      clearTimeout(timer);
      root.style.setProperty("--delay", `${DELAY}ms`);
      root.classList.remove("is-running");
      void root.offsetWidth;
      if (paused) return;
      root.classList.add("is-running");
      if (!document.hidden) timer = window.setTimeout(() => go(index + 1), DELAY);
    }
    // Botón de pausa (si alguien quiere leer con calma)
    let userPaused = false;
    const pauseBtn = root.querySelector<HTMLButtonElement>("[data-pause]")!;
    pauseBtn.addEventListener("click", () => {
      userPaused = !userPaused;
      paused = userPaused || reduce;
      pauseBtn.setAttribute("aria-pressed", String(userPaused));
      pauseBtn.setAttribute("aria-label", userPaused ? "Reanudar portadas" : "Pausar portadas");
      root.classList.toggle("is-paused", userPaused);
      restart();
    });
    // Al deslizar con el dedo se detiene y retoma sola a los 8 s
    let resumeTimer = 0;
    track.addEventListener(
      "pointerdown",
      () => {
        paused = true;
        restart();
        clearTimeout(resumeTimer);
        resumeTimer = window.setTimeout(() => {
          paused = userPaused || reduce;
          restart();
        }, 8000);
      },
      { passive: true },
    );
    document.addEventListener("visibilitychange", restart);
    restart();
  });
</script>
