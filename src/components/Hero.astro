---
// Portada principal: foto real en arco + mensaje + dos acciones.
// Para cambiar la foto, reemplaza el import de abajo.
import { Image } from "astro:assets";
import Icon from "./Icon.astro";
import { site, waLink } from "../data/site";
import foto from "../assets/galeria/7.jpg";
---
<section class="hero2 container" aria-labelledby="hero-title">
  <div class="hero2__copy">
    <h1 class="hero2__title" id="hero-title">Flores hechas a mano en Comas, con delivery en Lima</h1>
    <p class="hero2__lead">Ramos, box y arreglos para cada momento. Elige en la tienda o arma el tuyo, y nosotros lo llevamos.</p>
    <div class="hero2__actions">
      <a href="/tienda" class="btn btn--primary btn--lg">Ver la tienda <Icon name="arrow" /></a>
      <a href={waLink()} target="_blank" rel="noopener" class="btn btn--outline btn--lg"><Icon name="chat" /> Pedir por WhatsApp</a>
    </div>
    <ul class="hero2__facts">
      <li><Icon name="truck" /> Delivery a domicilio</li>
      <li><Icon name="store" /> Recojo en {site.direccion.split(",")[0]}</li>
      <li><Icon name="clock" /> Todos los días, 7:30 a.m. a 11:30 p.m.</li>
    </ul>
  </div>

  <div class="hero2__media">
    <Image src={foto} alt="Ramo de rosas rojas preparado por M&S Detalles" width={720} loading="eager" fetchpriority="high" />
    <!-- Sello giratorio con el lema de la marca -->
    <svg class="hero2__seal" viewBox="0 0 200 200" aria-hidden="true">
      <defs><path id="seal-path" d="M100,100 m-74,0 a74,74 0 1,1 148,0 a74,74 0 1,1 -148,0" /></defs>
      <circle cx="100" cy="100" r="98" class="hero2__seal-bg" />
      <g class="hero2__ring"><text><textPath href="#seal-path" textLength="462" lengthAdjust="spacing">Cada detalle dice lo que sientes ✿ Cada detalle dice lo que sientes ✿</textPath></text></g>
      <path class="hero2__seal-heart" d="M100 122s-20-12.5-20-29a11 11 0 0 1 20-6.3A11 11 0 0 1 120 93c0 16.5-20 29-20 29z" />
    </svg>
  </div>
</section>
