---
import { site, waLink, unsplash } from "../data/site";
const year = new Date().getFullYear();
const ocasiones = "SAN VALENTÍN / DÍA DE LA MADRE / ANIVERSARIO / CUMPLEAÑOS / NAVIDAD / GRADUACIÓN / ";
---
<footer class="footer" id="contacto">
  <div class="container footer__grid">
    <div class="footer__brand">
      <a href="/" class="footer__logo" aria-label="MyS Florería, inicio">
        <img src="/logo-completo.png" alt="MyS Detalles Florería" width="480" height="480" loading="lazy" />
      </a>
      <p>Únete a nuestra comunidad de amantes de las flores</p>
      <div class="footer__thumbs">
        <img src={unsplash("photo-1606041008023-472dfb5e530f", 120)} alt="" />
        <img src={unsplash("photo-1470509037663-253afd7f0f51", 120)} alt="" />
      </div>
    </div>
    <div class="footer__col">
      <span class="footer__label">Visítanos</span>
      <p>{site.direccion}</p>
      <p class="footer__small">{site.horario}</p>
      <ul class="footer__links">
        <li><a href="/tienda">Tienda</a></li>
        <li><a href="/#nosotros">Nosotros</a></li>
        <li><a href="/#ocasiones">Ocasiones</a></li>
        <li><a href="/#delivery">Zonas de delivery</a></li>
        <li><a href="#">Libro de Reclamaciones</a></li>
        <li><a href="#">Términos y condiciones</a></li>
      </ul>
    </div>
    <div class="footer__col footer__col--right">
      <span class="footer__label">¿Tienes alguna consulta?</span>
      <a class="footer__phone" href={waLink()} target="_blank" rel="noopener">{site.celular}</a>
      <a class="footer__phone" href={`tel:${site.telefono.replace(/\D/g, "")}`}>{site.telefono}</a>
      <a class="footer__mail" href={`mailto:${site.correo}`}>{site.correo}</a>
      <span class="footer__label footer__label--mt">Síguenos en redes</span>
      <div class="socials">
        <a href={site.redes.instagram} target="_blank" rel="noopener" aria-label="Instagram"><svg viewBox="0 0 24 24"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor"/></svg></a>
        <a href={site.redes.facebook} target="_blank" rel="noopener" aria-label="Facebook"><svg viewBox="0 0 24 24"><path d="M14 8h3V4h-3a4 4 0 0 0-4 4v3H7v4h3v6h4v-6h3l1-4h-4V8z"/></svg></a>
        <a href={site.redes.tiktok} target="_blank" rel="noopener" aria-label="TikTok"><svg viewBox="0 0 24 24"><path d="M14 3v11.5a3.5 3.5 0 1 1-3-3.46M14 3c.5 2.5 2.5 4.5 5 4.5"/></svg></a>
      </div>
    </div>
  </div>
  <div class="container footer__bottom">
    <span>© {year} MyS Florería. Todos los derechos reservados.</span>
    <span>Hecho con 🌸 en Lima, Perú</span>
  </div>
  <div class="marquee" aria-hidden="true">
    <div class="marquee__inner"><span>{ocasiones}</span><span>{ocasiones}</span></div>
  </div>
</footer>
