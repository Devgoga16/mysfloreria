---
import { site, waLink } from "../data/site";
import Icon from "./Icon.astro";
const year = new Date().getFullYear();
const ocasiones = ["San Valentín", "Día de la Madre", "Aniversarios", "Cumpleaños", "Navidad", "Graduaciones"];
---
<footer class="footer" id="contacto">
  <div class="marquee" aria-hidden="true">
    <div class="marquee__inner">
      {[0, 1].map(() => (
        <span>{ocasiones.map((o) => <Fragment>{o}<b>✿</b></Fragment>)}</span>
      ))}
    </div>
  </div>

  <div class="container footer__grid">
    <div class="footer__brand">
      <a href="/" class="footer__logo" aria-label="M&amp;S Detalles, inicio">
        <img src="/logo-completo.png" alt="Florería M&amp;S Detalles" width="480" height="480" loading="lazy" />
      </a>
      <p>Arreglos florales y detalles hechos a mano en Lima, para decir lo que sientes.</p>
      <div class="socials">
        <a href={site.redes.instagram} target="_blank" rel="noopener" aria-label="Instagram"><svg viewBox="0 0 24 24"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor"/></svg></a>
        <a href={site.redes.facebook} target="_blank" rel="noopener" aria-label="Facebook"><svg viewBox="0 0 24 24"><path d="M14 8h3V4h-3a4 4 0 0 0-4 4v3H7v4h3v6h4v-6h3l1-4h-4V8z"/></svg></a>
        <a href={site.redes.tiktok} target="_blank" rel="noopener" aria-label="TikTok"><svg viewBox="0 0 24 24"><path d="M14 3v11.5a3.5 3.5 0 1 1-3-3.46M14 3c.5 2.5 2.5 4.5 5 4.5"/></svg></a>
      </div>
    </div>

    <div>
      <h3>Tienda</h3>
      <ul class="footer__links">
        <li><a href="/tienda">Todos los arreglos</a></li>
        <li><a href="/#categorias">Tipos de arreglos</a></li>
        <li><a href={waLink("¡Hola! Quisiera un arreglo personalizado 🌷")} target="_blank" rel="noopener">Pedido personalizado</a></li>
      </ul>
    </div>

    <div>
      <h3>Ayuda</h3>
      <ul class="footer__links">
        <li><a href="/ayuda/preguntas-frecuentes">Preguntas frecuentes</a></li>
        <li><a href="/ayuda/envios">Envíos y entregas</a></li>
        <li><a href="/ayuda/terminos">Términos y condiciones</a></li>
        <li><a href="/ayuda/privacidad">Política de privacidad</a></li>
        <li><a href="#">Libro de Reclamaciones</a></li>
      </ul>
    </div>

    <div>
      <h3>Contacto</h3>
      <div class="footer__contact">
        <a href={waLink()} target="_blank" rel="noopener"><Icon name="chat" /><span class="footer__strong">{site.celular}</span></a>
        <a href={`mailto:${site.correo}`}><Icon name="mail" />{site.correo}</a>
        <p><Icon name="pin" />{site.direccion}</p>
        <p><Icon name="clock" /><span>{site.horario.split(" · ").map((h) => <small>{h}</small>)}</span></p>
      </div>
    </div>
  </div>

  <div class="container footer__bottom">
    <span>© {year} Florería M&amp;S Detalles. Todos los derechos reservados.</span>
    <span>Hecho con cariño en Lima, Perú</span>
  </div>
</footer>
