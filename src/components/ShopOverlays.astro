---
// Paneles laterales (carrito y favoritos) y aviso. Van una vez en el layout.
---
<div class="drawer-overlay" id="drawer-overlay" data-drawer-close></div>

<aside class="drawer" id="cart" aria-label="Carrito de compras">
  <header class="drawer__head">
    <div>
      <span class="eyebrow">Tu pedido</span>
      <h2 class="serif">Carrito</h2>
    </div>
    <button class="round-btn" data-drawer-close aria-label="Cerrar carrito">✕</button>
  </header>
  <p class="cart__msg" role="alert" hidden></p>
  <div class="drawer__body"></div>
  <div class="drawer__foot"></div>
</aside>

<aside class="drawer" id="favs" aria-label="Favoritos">
  <header class="drawer__head">
    <div>
      <span class="eyebrow">Guardados</span>
      <h2 class="serif">Favoritos</h2>
    </div>
    <button class="round-btn" data-drawer-close aria-label="Cerrar favoritos">✕</button>
  </header>
  <div class="drawer__body"></div>
</aside>

<div class="toast" id="toast" role="status" aria-live="polite"></div>

<script>
  import { initShopUI } from "../lib/shop";
  initShopUI();
</script>
