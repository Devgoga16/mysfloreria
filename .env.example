# Llave publicable de la tienda (uTracker → Integración). Copia este archivo como .env
PUBLIC_UTRACKER_KEY=
# Opcional: base de la API
PUBLIC_UTRACKER_API=https://utracker-api.unify-tc.com/api

# ---------- Medición (Google Analytics 4 y Google Ads) ----------
# Mientras estén vacías no se carga nada de Google en la web.
# GA4: Administrar → Flujos de datos → ID de medición (empieza con G-)
PUBLIC_GA4_ID=
# Google Ads: Objetivos → Conversiones → etiqueta → ID (empieza con AW-)
PUBLIC_GADS_ID=
# Etiquetas de conversión de Google Ads (la parte después de la barra en "AW-123/abcDEF")
PUBLIC_GADS_LABEL_PURCHASE=
PUBLIC_GADS_LABEL_LEAD=
PUBLIC_GADS_LABEL_CHECKOUT=
